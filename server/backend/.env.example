APP_NAME=scribe-backend
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=sqlite:///./scribe.db
USE_DEMO_DATA=true
GRANOLA_API_BASE_URL=https://public-api.granola.ai/v1
GRANOLA_API_KEY=replace-me
GRANOLA_AUTH_HEADER=Authorization
GRANOLA_AUTH_SCHEME=Bearer
RECALL_REGION=us-east-1
RECALL_API_BASE_URL=https://us-east-1.recall.ai/api/v1
# Get the API key and workspace verification secret for this region from https://us-east-1.recall.ai/dashboard/developers/api-keys
RECALL_API_KEY=
# The app accepts RECALL_WEBHOOK_SECRET as a legacy alias for this setting.
RECALL_WORKSPACE_VERIFICATION_SECRET=
# Use a stable public backend URL, such as your reserved ngrok domain; never localhost.
PUBLIC_API_BASE_URL=https://your-static-domain.ngrok-free.dev
